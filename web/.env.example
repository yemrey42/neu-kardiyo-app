# Supabase (EU / Frankfurt bölgesinde proje açın). Şimdilik yalnızca e-posta + şifre girişi için.
# Varsayılanları lib/supabaseConfig.ts içinde; başka bir projeye geçmek için doldurun.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://neu-cardio.com.tr

# --- Klinik çalışma veri girişi (şimdilik Google Sheets) ---
# Streamlit secrets'taki [gcp_service_account] bölümünden iki değer:
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Verilmezse Streamlit'in kullandığı tablo kullanılır
GOOGLE_SHEET_ID=

# İsteğe bağlı: PubMed için ücretsiz NCBI API anahtarı
NCBI_API_KEY=
